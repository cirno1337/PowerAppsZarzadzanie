# Copy to a local, git-ignored ".env" (repo root) and fill in real values
# only once corporate access exists. NEVER commit a filled-in .env — see
# SECURITY.md. Names only below; every value is safe to leave unset for
# local/mock development (defaults live in worker/config.py).

# --- Adapter mode selection: "mock" (default) | "human_review" (copilot only) | "real"
PPDM_POWERPLATFORM_MODE=mock
PPDM_SHAREPOINT_MODE=mock
PPDM_COPILOT_MODE=mock

# --- Local/mock data locations (safe defaults, override if needed)
PPDM_LOCAL_DATA_DIR=.local_data
PPDM_MOCK_SOLUTIONS_DIR=examples/mock_solution

# --- Worker identity/behavior
PPDM_WORKER_ID=local-dev-worker
PPDM_MAX_RETRIES=3
PPDM_POLL_INTERVAL_SECONDS=5
PPDM_VERBOSE_LOGGING=false

# --- REQUIRES TENANT CONFIGURATION: leave blank until corporate access
# exists (see docs/CORPORATE_SETUP.md). Never put a real value in this
# .example file.
PPDM_SHAREPOINT_SITE_URL=
PPDM_POWERPLATFORM_ENVIRONMENT_URL=

# --- REQUIRES TENANT CONFIGURATION: app registration for
# RealSharePointAdapter's Microsoft Graph app-only auth (client
# credentials flow) -- needs a Graph Application permission of
# Sites.ReadWrite.All or Sites.Manage.All with admin consent granted. See
# docs/SHAREPOINT_SETUP.md. This should NOT be the same app registration
# the worker runs as long-term in production -- narrow it once corporate
# access allows setting up least-privilege permissions (SECURITY.md).
PPDM_SHAREPOINT_TENANT_ID=
PPDM_SHAREPOINT_CLIENT_ID=
PPDM_SHAREPOINT_CLIENT_SECRET=

# --- REQUIRES LICENSING VERIFICATION: Copilot Studio Direct Line secret
# for RealCopilotAdapter (Settings -> Security -> Web channel security on
# the agent). See docs/COPILOT_INTEGRATION.md.
PPDM_COPILOT_DIRECTLINE_SECRET=
